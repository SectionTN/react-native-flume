{
  "name": "react-native-flume",
  "version": "0.1.0",
  "description": "Native list for React Native with worklet cells",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-flume-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!android/build",
    "!android/.cxx",
    "!android/src/test",
    "!cpp/tests",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-flume-example",
    "clean": "del-cli lib build android/build android/.cxx",
    "prepare": "bob build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc && tsc -p tsconfig.legacy-types.json",
    "bench": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON example/benchmark/run.mts",
    "test": "vitest run",
    "test:cpp": "scripts/test-cpp.sh",
    "test:android": "cd example/android && ./gradlew :react-native-flume:testReleaseUnitTest --console=plain -q",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "list",
    "recyclerview",
    "uicollectionview",
    "worklets",
    "flashlist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SectionTN/react-native-flume.git"
  },
  "author": "Rayen Sbai <rayensbai2@gmail.com> (https://github.com/SectionTN)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SectionTN/react-native-flume/issues"
  },
  "homepage": "https://github.com/SectionTN/react-native-flume#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "2.5.15",
    "@commitlint/config-conventional": "^21.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "lefthook": "^2.1.10",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.2",
    "react-native-worklets": "0.13.0",
    "react-test-renderer": "19.2.3",
    "release-it": "^21.1.2",
    "typescript": "^6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.83.0",
    "react-native-worklets": ">=0.9.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "codegenConfig": {
    "name": "FlumeSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "me.sectiontn.flume"
    },
    "ios": {
      "components": {
        "FlumeView": {
          "className": "FLMView"
        },
        "FlumeSlotView": {
          "className": "FLMSlotView"
        }
      },
      "modules": {
        "NativeFlume": {
          "className": "FLMFlumeModule"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "parserOpts": {
          "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$",
          "breakingHeaderPattern": "^(\\w*)(?:\\((.*)\\))?!: (.*)$"
        }
      }
    }
  }
}
